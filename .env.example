# My Timelineはプロジェクト直下の .env を読みます。
# 必要な取得元の項目だけコピーし、exportを付けずに値を記入してください。

# Bluesky / bskylog（既定値を変える場合のみ）
BSKYLOG_MCP_URL="http://localhost:8080/sse"

# X / Twilog（通常はブラウザOAuthを使うため未設定で構いません）
TWILOG_MCP_URL="https://twilog-mcp.togetter.dev/mcp"
# TWILOG_MCP_TOKEN=""
# MCP_REMOTE_COMMAND="npx"

# Flickr（公開写真ではKEYとUSER_IDが必須）
FLICKR_API_KEY=""
FLICKR_API_SECRET=""
FLICKR_USER_ID=""
# 以下は flickr-auth 成功時に自動追記されます。
# FLICKR_OAUTH_TOKEN=""
# FLICKR_OAUTH_TOKEN_SECRET=""

# Strava（画面のStrava設定から保存できます）
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# STRAVA_ACCESS_TOKEN=""
# STRAVA_REFRESH_TOKEN=""
# STRAVA_EXPIRES_AT="0"

# Gmail（画面のGmail設定から保存できます）
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""

# 標準構成は4177固定です。Gmail OAuthのリダイレクトURIも合わせる必要があります。
# MY_TIMELINE_PORT="4177"
